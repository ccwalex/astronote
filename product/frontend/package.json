{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "predev:full": "test -d venv || python3 -m venv venv && ./venv/bin/python3 -m pip install fastapi uvicorn python-multipart pillow mcp",
    "dev:full": "concurrently -k \"ASTRONOTE_API_HOST=0.0.0.0 ./venv/bin/python3 ../../code/api.py\" \"vite --host 0.0.0.0 --port 5173 --strictPort\"",
    "build": "tsc",
    "test:workspace-cache": "node --experimental-strip-types src/model/workspaceCache.test.ts",
    "test:workspace-dirty-gate": "node --experimental-strip-types src/model/workspaceDirtyGate.test.ts",
    "test:page-presence": "node --experimental-strip-types src/model/pagePresence.test.ts",
    "test:revision-poll": "node --experimental-strip-types src/model/revisionPoll.test.ts",
    "test:stale-save-recovery": "node --experimental-strip-types src/model/staleSaveRecovery.test.ts",
    "test:pending-persist": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs src/model/pendingPersistCache.test.ts",
    "test:asset-source": "node --experimental-strip-types src/model/assetSource.test.ts",
    "test:text-asset-load": "node --experimental-strip-types src/model/textAssetLoad.test.ts",
    "test:blank-paragraph-guards": "node --experimental-strip-types src/model/textSpaceBlankParagraphGuards.test.ts",
    "test:workspace-load": "node --experimental-strip-types src/model/workspaceLoad.test.ts",
    "test:workspace-save": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs src/model/workspaceSave.test.ts",
    "test:ungroup-layout": "node --experimental-strip-types src/model/ungroupSpaceWithLayout.test.ts",
    "test:bounce-above-bg": "node --experimental-strip-types src/model/bounceContentAboveBackground.test.ts",
    "test:deferred-space-selection": "node --experimental-strip-types src/model/deferredSpaceSelection.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/turndown": "^5.0.6",
    "concurrently": "^9.0.1",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^1.3.2",
    "typescript": "~4.9.5",
    "vite": "^2.9.18"
  }
}
